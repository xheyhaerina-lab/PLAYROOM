# ==============================================================================
# PLAYROOM — Environment Configuration
# ==============================================================================
# PUBLIC VARIABLES (exposed to browser via Vite — safe to share)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PRIVATE SERVER VARIABLES (NEVER expose to browser / NEVER prefix with VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
ADMIN_CLAIM_PASSCODE=

# INTERNATIONAL MERCHANT OF RECORD BILLING (Dodo Payments — Server-side only)
# Default currency is USD (stored in integer cents: 499 = $4.99/mo, 3999 = $39.99/yr)
PAYMENT_PROVIDER="dodo_payments"
DEFAULT_BILLING_CURRENCY="USD"
DODO_PAYMENTS_ENV="test_mode"
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PRODUCT_PLUS_MONTHLY_ID=
DODO_PRODUCT_PLUS_ANNUAL_ID=

# APPLICATION RUNTIME
APP_URL="http://localhost:3000"
APP_ENV="development"

# AI Studio Platform Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
